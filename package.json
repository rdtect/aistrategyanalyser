    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "@types/uuid": "^10.0.0",
    "mdsvex": "^0.12.5",
    "prettier": "3.5.3",
